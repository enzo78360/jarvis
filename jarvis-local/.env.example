# Réglages optionnels : copiez ce fichier en .env et retirez le # devant la ligne à changer.
# Jarvis fonctionne très bien sans fichier .env.

# JARVIS_VOICE=Thomas              # voix macOS (liste : say -v '?' | grep fr_FR) ; par défaut, la plus naturelle installée
# JARVIS_VITESSE=165               # vitesse de parole : 150 = plus lent, 185 = plus rapide
# JARVIS_CLAP_SENSIBILITE=1.0      # monter à 1.5 si les claps ne sont pas détectés, baisser à 0.7 si ça se déclenche tout seul
# JARVIS_MOT_CLE=1                 # 0 pour ne plus réveiller Jarvis en disant son nom (claps seulement)
# JARVIS_MODEL=qwen3:4b-instruct  # modèle Ollama (qwen3:8b est plus malin mais lent avec 8 Go de mémoire)
